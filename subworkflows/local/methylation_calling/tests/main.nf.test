nextflow_workflow {

    name "Test Subworkflow METHYLATION_CALLING"
    script "../main.nf"
    workflow "METHYLATION_CALLING"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/methylation_calling"
    tag "liftover"
    tag "liftover/liftover"
    tag "bedtools"
    tag "bedtools/intersect"
    tag "nanodx"
    tag "nanodx/classify"

    // TODO: add a non-stub test once a small model (.pkl), chain and probe BED are available as test data
    test("bedmethyl - chain - probes - model - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test', type:'tumour' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true),
                ])
                input[1] = channel.value([
                    [ id:'chain' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test2.bed', checkIfExists: true),
                ])
                input[2] = channel.value([
                    [ id:'probes' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/baits.bed', checkIfExists: true),
                ])
                input[3] = channel.value([
                    [ id:'model' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed12', checkIfExists: true),
                ])
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
