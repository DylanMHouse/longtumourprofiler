nextflow_workflow {

    name "Test Subworkflow ANNOTSV_SURVIVOR_ANNOTATE"
    script "../main.nf"
    workflow "ANNOTSV_SURVIVOR_ANNOTATE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/annotsv_survivor_annotate"
    tag "bcftools/view"
    tag "survivor/merge"
    tag "bcftools/sort"
    tag "annotsv/annotsv"

    // AnnotSV needs its full annotation bundle (tens of GB), so only the stub is tested here
    test("homo_sapiens - savana, severus vcf - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_T', patient:'test', type:'tumour' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf', checkIfExists: true)
                ])
                input[1] = Channel.value([
                    [ id:'annotations' ],
                    []
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
