nextflow_process {

    name "Test Process SCARHRD"
    script "../main.nf"
    process "SCARHRD"

    tag "modules"
    tag "modules_local"
    tag "scarhrd"

    // Synthetic ASCAT-style segments and purity/ploidy for GRCh38 chromosomes 1-22
    test("ascat segments - grch38") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.segments.txt", checkIfExists: true),
                    file("${moduleDir}/tests/data/test.purityploidy.txt", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.scores,
                    process.out.segments,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("ascat segments - grch38 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.segments.txt", checkIfExists: true),
                    file("${moduleDir}/tests/data/test.purityploidy.txt", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
