nextflow_process {

    name "Test Process PVACSEQ_RUN"
    script "../main.nf"
    process "PVACSEQ_RUN"

    tag "modules"
    tag "modules_"
    tag "pvacseq"
    tag "pvacseq/run"

    test("homo_sapiens - vcf, class I alleles - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/NA12878_GIAB.chr22.vcf.gz', checkIfExists: true),
                    'HLA-A*02:01,HLA-B*07:02',
                ]
                input[1] = 'NetMHCpanEL NetMHCpan MHCflurry'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
