nextflow_process {

    name "Test Process SVSIGNATURES"
    script "../main.nf"
    process "SVSIGNATURES"

    tag "modules"
    tag "modules_local"
    tag "svsignatures"

    // test.sv_signatures.tsv is a toy two-signature set over the SV32 channels, not a real RefSig catalogue
    test("savana bedpe - sv32 refit") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test.tumour' ],
                    file("${moduleDir}/tests/data/test.savana.somatic.bedpe", checkIfExists: true),
                ]
                input[1] = file("${moduleDir}/tests/data/test.sv_signatures.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.matrix,
                    process.out.signatures,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("savana bedpe - matrix only") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test.tumour' ],
                    file("${moduleDir}/tests/data/test.savana.somatic.bedpe", checkIfExists: true),
                ]
                input[1] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.signatures.isEmpty() },
                { assert snapshot(process.out.matrix).match() }
            )
        }

    }

    test("savana bedpe - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test.tumour' ],
                    file("${moduleDir}/tests/data/test.savana.somatic.bedpe", checkIfExists: true),
                ]
                input[1] = file("${moduleDir}/tests/data/test.sv_signatures.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
