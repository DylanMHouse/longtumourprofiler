nextflow_process {

    name "SPECIMMUNE_EXTRACTREADS"
    script "../main.nf"
    process "SPECIMMUNE_EXTRACTREADS"

    tag "modules"
    tag "modules_local"
    tag "specimmune"
    tag "specimmune/extractreads"

    test("homo_sapiens - ont - bam, IG_TR") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'IG_TR'
                ]
                input[1] = [
                    [ id:'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.fastq.collect { meta, gene_class, fq -> [ meta, gene_class, file(fq).name, path(fq).linesGzip.size() ] },
                    process.out.bam.collect { meta, gene_class, bam_file -> [ meta, gene_class, file(bam_file).name, bam(bam_file).getReadsMD5() ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

   test("homo_sapiens - pacbio - bam, HLA") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("\${projectDir}/tests/data/specimmune/test_HLA_lite.hg38.chr6.bam", checkIfExists: true),
                    [],
                    'HLA'
                ]
                input[1] = [ [:], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert snapshot(
                    process.out.fastq.collect { meta, gene_class, fq -> [ meta, gene_class, file(fq).name, path(fq).linesGzip.size() ] },
                    process.out.bam.collect { meta, gene_class, bam_file -> [ meta, gene_class, file(bam_file).name, bam(bam_file).getReadsMD5() ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("homo_sapiens - ont - bam, HLA - no reads in regions") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'HLA'
                ]
                input[1] = [
                    [ id:'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                // nothing for typing to run on
                { assert process.out.fastq.size() == 0 },
                { assert process.out.bam.size() == 1 }
            )
        }
    }

    test("homo_sapiens - ont - bam, IG_TR - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'IG_TR'
                ]
                input[1] = [
                    [ id:'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
