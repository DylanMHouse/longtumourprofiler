nextflow_process {

    name "Test Process MAFSMITH_FETCH"
    script "../main.nf"
    process "MAFSMITH_FETCH"

    tag "modules"
    tag "modules_local"
    tag "mafsmith"
    tag "mafsmith/fetch"

    test("grch38 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'grch38'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
