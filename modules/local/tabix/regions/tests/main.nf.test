nextflow_process {

    name "Test Process TABIX_REGIONS"
    script "../main.nf"
    process "TABIX_REGIONS"

    tag "modules"
    tag "modules_local"
    tag "tabix"
    tag "tabix/regions"

    // test.exome.bed is merged but lists chr2 first, so tabix writes chr2 before chr1
    test("vcf - unsorted bed") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.consensus.vcf.gz", checkIfExists: true),
                    file("${moduleDir}/tests/data/test.consensus.vcf.gz.tbi", checkIfExists: true),
                ]
                input[1] = file("${moduleDir}/tests/data/test.exome.bed", checkIfExists: true)
                """
            }
        }

        then {
            def records = path(process.out.vcf[0][1]).readLines().findAll { line -> !line.startsWith('#') }.collect { line -> line.tokenize('\t')[0..1].join(':') }
            assert process.success
            assertAll(
                { assert path(process.out.vcf[0][1]).readLines().any { line -> line.startsWith('#CHROM') } },
                { assert records == ['chr2:300', 'chr1:100', 'chr1:550'] },
                { assert snapshot(
                    process.out.vcf,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.consensus.vcf.gz", checkIfExists: true),
                    file("${moduleDir}/tests/data/test.consensus.vcf.gz.tbi", checkIfExists: true),
                ]
                input[1] = file("${moduleDir}/tests/data/test.exome.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
