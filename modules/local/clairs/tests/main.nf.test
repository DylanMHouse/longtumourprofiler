nextflow_process {

    name "Test Process CLAIRS"
    script "../main.nf"
    process "CLAIRS"

    tag "modules"
    tag "modules_local"
    tag "clairs"

    // COLO829 (tumour) and COLO829BL (matched normal) ONT R10.4.1 Dorado SUP BAMs, chr22.
    test("homo_sapiens - ont - bam - tumour, normal") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829bl.PAU59807.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829bl.PAU59807.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'ont_r10_dorado_sup_5khz_ssrs'
                ]
                input[1] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta.fai', checkIfExists: true)
                ]
                input[3] = []
                input[4] = []
                input[5] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.vcf.size() == 1 },
                // The header embeds the working directory, so compare only the variant records
                { assert snapshot(
                    process.out.vcf.collect { meta, vcf -> [ meta, path(vcf).linesGzip.findAll { line -> !line.startsWith('#') } ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("homo_sapiens - ont - bam - tumour, normal - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829bl.PAU59807.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829bl.PAU59807.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'ont_r10_dorado_sup_5khz_ssrs'
                ]
                input[1] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta.fai', checkIfExists: true)
                ]
                input[3] = []
                input[4] = []
                input[5] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
