/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    publishDir = [
        // Per-sample outputs go to ${outdir}/Tumour/<tool>, ${outdir}/Germline/<tool>, or ${outdir}/TN; shared outputs (reference) to ${outdir}/<tool>
        path: { "${params.outdir}/${meta?.type ? meta.type.capitalize() + '/' : ''}${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: SAMTOOLS_FASTQ {
        ext.args = '-T MM,ML,mv'
        cpus = 32
    }
    withName: SAMTOOLS_CAT {
        cpus = 32
    }
    withName: MINIMAP2_ALIGN {
        ext.args = { "--MD -Y -ax lr:hq -y -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ONT'" }
        cpus = 32
    }
    withName: PARABRICKS_MINIMAP2 {
        ext.args = { "--seeding-chaining-on-gpu on --gpusort --gpuwrite --preset lr:hq --num-gpus 4 --read-group-id-prefix ${meta.id} --read-group-sm ${meta.id} --read-group-lb ${meta.id} --read-group-pl ONT -y" }
        cpus = 32
    }
    withName: CLAIR3 {
        ext.prefix = { "${meta.id}_" }
        ext.args = { "--sample_name=${meta.id} --enable_dwell_time" }
        cpus = 42
    }

    withName: MOSDEPTH {
        ext.args = '--fast-mode'
    }
    withName: MOSDEPTH_SPECTRE {
        ext.args = { "--fast-mode --by ${params.spectre_bin_size} --no-per-base" }
        ext.prefix = { "${meta.id}.cnv_bins" }
        cpus = 42
    }

    withName: LONGPHASE_MODCALL {
        ext.prefix = { "${meta.id}_modcall" }
    }
    withName: LONGPHASE_PHASE {
        ext.args = '--ont'
        ext.prefix = { "${meta.id}.phased" }
    }
    withName: LONGPHASE_HAPLOTAG {
        ext.prefix = { "${meta.id}.haplotagged" }
        ext.args = '--tagSupplementary'
        cpus = 42
    }

    withName: STRDUST {
        ext.args = { "--sample ${meta.id} -s 2 ${params.phasing ? '' : '--unphased'}".trim() }
    }

    withName: MODKIT_PILEUP {
        ext.args = '--cpg --modified-bases 5mC '
    }

    withName: LIFTOVER_LIFTOVER {
        ext.prefix = { "${meta.id}.lifted" }
    }
    withName: '.*METHYLATION_CALLING:BEDTOOLS_INTERSECT' {
        ext.args = "-wa -wb | awk -v OFS='\\t' '{ \$4 = \$(NF-2); print }' | cut -f1-11"
        ext.prefix = { "${meta.id}.probes" }
    }

    withName: BCFTOOLS_SORT_CPSR {
        ext.args = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: BCFTOOLS_VIEW_PASS {
        ext.args = '--apply-filters PASS --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.pass" }
    }
    withName: CPSR {
        ext.genome = { params.genome == 'GRCh37' ? 'grch37' : 'grch38' }
        ext.args = '--panel_id 0 --secondary_findings --classify_all --force_overwrite'
    }
    withName: GAWK_PCGR_CNA {
        ext.args = "-F '\\t'"
        ext.args2 = '\'BEGIN { OFS = "\\t"; print "Chromosome", "Start", "End", "nMajor", "nMinor" } FNR == 1 { next } { print $2, $3, $4, $5, $6 }\''
        ext.prefix = { "${meta.id}.pcgr_cna" }
    }
    withName: PCGR {
        ext.genome = { params.genome == 'GRCh37' ? 'grch37' : 'grch38' }
        ext.args = [
            '--assay WES',
            '--estimate_signatures --all_reference_signatures --include_artefact_signatures',
            '--estimate_tmb --estimate_msi',
            '--force_overwrite',
        ].join(' ')
    }

    withName: PHARMCAT_PIPELINE {
        ext.args = '-reporterCallsOnlyTsv'
    }

    withName: ENSEMBLVEP_VEP {
        // The plugin folder is staged into the work dir, so only its basename is needed
        ext.args = {
            [
                '--format vcf --vcf --symbol --terms SO --tsl --biotype --hgvs --offline',
                '--plugin Frameshift --plugin Wildtype',
                "--dir_plugins ${params.pvacseq_vep_plugins.toString().tokenize('/').last()}",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.vep" }
    }
    withName: PVACSEQ_RUN_CLASSI {
        ext.args = '-e1 8,9,10,11 --iedb-install-directory /opt/iedb'
    }
    withName: PVACSEQ_RUN_CLASSII {
        ext.args = '-e2 12,13,14,15,16,17,18 --iedb-install-directory /opt/iedb'
    }

    withName: SPECIMMUNE_EXTRACTREADS {
        ext.args = ''
    }
    withName: SPECIMMUNE_TYPING {
        ext.args = '-y nanopore --align_method_1 minimap2'
    }

    withName: CLAIRS {
        ext.args = '--haplotagged_tumor_bam_provided_so_skip_intermediate_phasing_and_haplotagging --enable_indel_calling'
        publishDir = [
            path: { "${params.outdir}/BALTI/clairs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DEEPSOMATIC {
        ext.args = { "--model_type=ONT --sample_name_tumor ${meta.id} --sample_name_normal ${meta.id}_normal" }
        ext.prefix = { "${meta.id}.${meta.chunk}" }
        cpus = 16
        time = { 8.h * task.attempt }
        publishDir = [enabled: false]
    }

    withName: DEEPSOMATIC_CONCAT {
        ext.args = '--allow-overlaps --remove-duplicates --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/BALTI/deepsomatic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: BCFTOOLS_CONCAT {
        ext.args = '--allow-overlaps --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.clairs" }
        publishDir = [
            path: { "${params.outdir}/BALTI/clairs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SAMTOOLS_VIEW_PREPARE_SV {
        ext.args = '-b --remove-tag mv,MM,ML,MN'
        cpus = 16
        publishDir = [
            path: { "${params.outdir}/BALTI/rationalized_bams" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]

    }

    withName: WAKHAN_ALL {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/BALTI/wakhan" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ASCAT {
        ext.args = {
            [
                gender: params.ascat_sex,
                genomeVersion: params.ascat_genome,
                purity: params.ascat_purity,
                ploidy: params.ascat_ploidy,
                penalty: params.ascat_penalty,
                additional_allelecounter_flags: '-f 0',
            ]
        }
        publishDir = [
            path: { "${params.outdir}/BALTI/ascat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCARHRD {
        ext.args = {
            [reference: params.ascat_genome == 'hg19' ? 'grch37' : 'grch38']
        }
        publishDir = [
            path: { "${params.outdir}/BALTI/scarHRD" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: TABIX_REGIONS_EXOME {
        ext.args = '-fh'
        ext.prefix = { "${meta.id}_consensus_exome.unsorted" }
        publishDir = [enabled: false]
    }

    withName: BCFTOOLS_SORT_EXOME {
        ext.args = '-Ou'
        ext.prefix = { "${meta.id}_consensus_exome" }
        publishDir = [
            path: { "${params.outdir}/BALTI/ont_exome_sort" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: MAFSMITH_EXOME {
        ext.prefix = { "${meta.id}_consensus_exome" }
        publishDir = [
            path: { "${params.outdir}/BALTI/mafsmith_exome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SAVANA_PASS_BCFTOOLS {
        ext.args = '--apply-filters PASS --output-type v'
        ext.prefix = { "${meta.id}.savana.pass" }
        publishDir = [enabled: false]
    }

    withName: SURVIVOR_MERGE {
        ext.prefix = { "${meta.id}.savana_severus.merged" }
        publishDir = [enabled: false]
    }

    withName: SAVANA_SEVERUS_SORT {
        ext.args = '--output-type v'
        ext.prefix = { "${meta.id}.savana_severus" }
        publishDir = [
            path: { "${params.outdir}/BALTI/survivor" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ANNOTSV_ANNOTSV {
        ext.args = { "-genomeBuild ${params.genome == 'GRCh37' ? 'GRCh37' : 'GRCh38'}" }
        ext.prefix = { "${meta.id}.savana_severus.annotsv" }
        publishDir = [
            path: { "${params.outdir}/BALTI/annotsv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SIGPROFILERASSIGNMENT {
        ext.args = { "--genome ${params.genome == 'GRCh37' ? 'GRCh37' : 'GRCh38'} --include-indels" }
        publishDir = [
            path: { "${params.outdir}/BALTI/sigprofiler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SVSIGNATURES {
        ext.args = { "--genome ${params.genome == 'GRCh37' ? 'GRCh37' : 'GRCh38'}" }
        ext.prefix = { "${meta.id}_sv" }
        publishDir = [
            path: { "${params.outdir}/BALTI/sigprofiler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*SOMALIER_RAITA_IDENTITY:(SOMALIER_EXTRACT|SOMALIER_RELATE|RAITA_RAITA)' {
        publishDir = [
            path: { "${params.outdir}/BALTI/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*BAM_CALL_SOMATIC_CLAIRS_DEEPSOMATIC:(CLAIRS|PARABRICKS_DEEPVARIANT)' {
        publishDir = [
            path: { "${params.outdir}/BALTI/${task.process.tokenize(':')[-1].replace('PARABRICKS_', '').toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
