/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    publishDir = [
        // Per-sample outputs go to ${outdir}/Tumour/<tool>, ${outdir}/Germline/<tool>, or ${outdir}/TN; shared outputs (reference, MultiQC) to ${outdir}/<tool>
        path: { "${params.outdir}/${meta?.type ? meta.type.capitalize() + '/' : ''}${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        cpus = 4
        memory = 40.GB
    }
    withName: SAMTOOLS_FASTQ {
        ext.args = '-T MM,ML,mv'
        cpus = 32
    }
    withName: SAMTOOLS_CAT {
        cpus = 32
    }
    withName: MINIMAP2_ALIGN {
        ext.args = { "--MD -Y -ax lr:hq -y' -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ONT'" }
        cpus = 32
    }
    withName: PARABRICKS_MINIMAP2 {
        ext.args = { "--seeding-chaining-on-gpu on --gpusort --gpuwrite --preset lr:hq --num-gpus 4 --read-group-id-prefix ${meta.id} --read-group-sm ${meta.id} --read-group-lb ${meta.id} --read-group-pl ONT -y" }
        cpus = 32
    }
    withName: CLAIR3 {
        ext.prefix = { "${meta.id}_" }
        ext.args = { "--sample_name=${meta.id} --enable_dwell_time" }
        cpus = 42
    }

    withName: MOSDEPTH {
        ext.args = '--fast-mode'
    }
    withName: MOSDEPTH_SPECTRE {
        ext.args = { "--fast-mode --by ${params.spectre_bin_size} --no-per-base" }
        ext.prefix = { "${meta.id}.cnv_bins" }
        cpus = 42
    }

    withName: LONGPHASE_MODCALL {
        ext.prefix = { "${meta.id}_modcall" }
    }
    withName: LONGPHASE_PHASE {
        ext.args = '--ont'
        ext.prefix = { "${meta.id}.phased" }
    }
    withName: LONGPHASE_HAPLOTAG {
        ext.prefix = { "${meta.id}.haplotagged" }
        ext.args = '--tagSupplementary'
        cpus = 42
    }

    withName: STRDUST {
        ext.args = { "--sample ${meta.id} -s 2 ${params.phasing ? '' : '--unphased'}".trim() }
    }

    withName: MODKIT_PILEUP {
        ext.args = '--cpg --modified-bases 5mC '
    }

    withName: LIFTOVER_LIFTOVER {
        ext.prefix = { "${meta.id}.lifted" }
    }
    withName: 'METHYLATION_CALLING:BEDTOOLS_INTERSECT' {
        ext.args = "-wa -wb | awk -v OFS='\\t' '{ \$4 = \$(NF-2); print }' | cut -f1-11"
        ext.prefix = { "${meta.id}.probes" }
    }

    withName: BCFTOOLS_SORT_CPSR {
        ext.args = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: BCFTOOLS_VIEW_PASS {
        ext.args = '--apply-filters PASS --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.pass" }
    }
    withName: CPSR {
        ext.genome = { params.genome == 'GRCh37' ? 'grch37' : 'grch38' }
        ext.args = '--panel_id 0 --secondary_findings --classify_all --force_overwrite'
    }

    withName: SPECIMMUNE_EXTRACTREADS {
        ext.args = ''
    }
    withName: SPECIMMUNE_TYPING {
        ext.args = '-y nanopore --align_method_1 minimap2'
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode]
    }
    withName: CLAIRS {
        ext.args = '--haplotagged_tumor_bam_provided_so_skip_intermediate_phasing_and_haplotagging --enable_indel_calling'
        }

    withName: DEEPSOMATIC {
        ext.args = { "--postprocess_variants_extra_args=\"cpus=32,num_partitions=64\" --sample_name_tumor ${meta.id} --sample_name_normal ${meta.id}_normal" }
    }

    withName: BCFTOOLS_MERGE {
        ext.args = '--output-type z --write-index=tbi --force-samples'
        ext.prefix = { "${meta.id}.clairs" }
        publishDir = [
            path: { "${params.outdir}/BALTI/clairs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SAMTOOLS_VIEW_PREPARE_SV {
        ext.args = '-b --remove-tag mv,MM,ML,MN'
    }

    withName: WAKHAN_ALL {
        ext.args = ''
    }

    withName: ASCAT {
        ext.args = {
            [
                gender: params.ascat_sex,
                genomeVersion: params.ascat_genome,
                purity: params.ascat_purity,
                ploidy: params.ascat_ploidy,
                penalty: params.ascat_penalty,
                additional_allelecounter_flags: '-f 0',
            ]
        }
    }

    withName: '.*SOMALIER_RAITA_IDENTITY:(SOMALIER_EXTRACT|SOMALIER_RELATE|RAITA_RAITA)' {
        publishDir = [
            path: { "${params.outdir}/BALTI/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*BAM_CALL_SOMATIC_CLAIRS_DEEPSOMATIC:(CLAIRS|DEEPSOMATIC|PARABRICKS_DEEPVARIANT)' {
        publishDir = [
            path: { "${params.outdir}/BALTI/${task.process.tokenize(':')[-1].replace('PARABRICKS_', '').toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

}
